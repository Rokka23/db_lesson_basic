Q10\uc0\u12288 \u21517 \u21069 \u12392 \u37096 \u32626 \u21517 \u12392 \u12381 \u12398 \u20154 \u12364 \u25552 \u20986 \u12375 \u12383 \u26085 \u22577 \u12398 \u20869 \u23481 \u12434 \u21516 \u26178 \u12395 \u21462 \u24471 \u12375 \u12390 \u12367 \u12384 \u12373 \u12356 \u12290 \u65288 \u26085 \u22577 \u12434 \u25552 \u20986 \u12375 \u12390 \u12356 \u12394 \u12356 \u20154 \u12399 \u21547 \u12417 \u12394 \u12356 \u65289 \
SELECT people.name, departments.name AS department_name, reports.content FROM people \
INNER JOIN departments ON people.department_id = departments.department_id\
INNER JOIN reports ON people.person_id = reports.person_id;\
\
\
Q11\uc0\u12288 \u26085 \u22577 \u12434 \u19968 \u12388 \u12418 \u25552 \u20986 \u12375 \u12390 \u12356 \u12394 \u12356 \u20154 \u12398 \u21517 \u21069 \u19968 \u35239 \u12434 \u21462 \u24471 \u12375 \u12390 \u12367 \u12384 \u12373 \u12356 \u12290 \
SELECT people.name FROM people LEFT JOIN reports ON people.person_id = reports.person_id\
WHERE reports.person_id IS NULL;}